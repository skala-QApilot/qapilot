# LLM (개인 OpenAI 키 발급 후 채워넣기)
OPENAI_API_KEY=

# Database (docker-compose 로 띄운 Postgres)
DATABASE_URL=postgresql://qapilot:qapilot@localhost:5432/qapilot

# Redis (SSE pub/sub + Celery broker)
REDIS_URL=redis://localhost:6379/0

# Vector DB
QDRANT_URL=http://localhost:6333

# S3 / MinIO (docker-compose 의 minio 컨테이너)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=qapilot-local
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE_ACCESS=true

# Spring → FastAPI 내부 호출 토큰 (양쪽 동일 값이어야 함)
QAPILOT_INTERNAL_API_TOKEN=qapilot-dev-token-1234

# 테스트 대상 SUT 의 로컬 경로 (각자 환경에 맞게 수정)
QAPILOT_TARGET_ROOT=/absolute/path/to/system-under-test

# Server (팀 공유 시 — 사용 안 하면 비워둬도 됨)
SERVER_URL=
SERVER_TOKEN=
